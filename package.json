{
  "name": "quiz-site",
  "private": true,
  "version": "1.0.0",
  "description": "Multilingual quiz: world geography, history & culture, logic & numbers, science & nature.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
